[web]
web01 ansible_host=YOUR_WEB_PUBLIC_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/ansible-lab-key.pem

[db]
db01 ansible_host=YOUR_DB_PRIVATE_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/ansible-lab-key.pem ansible_ssh_common_args='-o ProxyCommand="ssh -i ~/.ssh/ansible-lab-key.pem -W %h:%p ubuntu@YOUR_WEB_PUBLIC_IP"'
